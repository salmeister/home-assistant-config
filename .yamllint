extends: default

ignore: |
  entity_registry_snapshot.json
  lovelace_raw_configuration.yaml
  secrets.yaml
  zones.yaml

rules:
  # Requested relaxations.
  line-length: disable
  document-start: disable
  truthy: disable
  # Existing Home Assistant YAML is included as fragments and is not
  # reformatted by this change. These style rules would fail the current
  # files without a repo-wide rewrite. Parse errors, duplicate keys, and
  # broken brackets still fail.
  indentation: disable
  comments: disable
  trailing-spaces: disable
  new-line-at-end-of-file: disable
  new-lines: disable
